# yaml-language-server: $schema=https://dv-flow.github.io/flow.dv.schema.json
# Example: Using std.Agent to analyze OpenROAD flow logs
# Requires: GitHub Copilot CLI or OpenAI Codex CLI to be authenticated
#
# Run: OPENROAD_EXE=... YOSYS_EXE=... dfm run analyze

package:
  name: gcd_log_analysis

  imports:
  - name: orfs
  - name: orfs.nangate45

  tasks:
  - name: pdk
    uses: orfs.nangate45.Platform

  - name: rtl
    uses: std.FileSet
    with:
      type: verilogSource
      include: "src/gcd.v"

  - name: sdc
    uses: std.FileSet
    with:
      type: sdc
      include: "src/constraint.sdc"

  - name: design
    uses: orfs.DesignConfig
    needs: [rtl, sdc]
    with:
      design_name: gcd
      clock_period_ps: 1100

  - name: synth
    uses: orfs.Synth
    needs: [pdk, design]

  - name: floorplan
    uses: orfs.Floorplan
    needs: [pdk, design, synth]
    with:
      core_utilization: 45

  - name: place
    uses: orfs.Place
    needs: [pdk, design, floorplan]

  - name: cts
    uses: orfs.CTS
    needs: [pdk, design, place]

  - name: grt
    uses: orfs.GlobalRoute
    needs: [pdk, design, cts]

  - name: route
    uses: orfs.Route
    needs: [pdk, design, grt]

  - name: finish
    uses: orfs.Finish
    needs: [pdk, design, route]

  - name: analyze
    uses: std.Agent
    needs: [finish]
    with:
      result_file: "analyze.result.json"
      user_prompt: |
        You have been given outputs from an OpenROAD RTL-to-GDS flow run for the 'gcd' design.

        The inputs include a FileSet of type 'orfsMetrics' containing a JSON metrics file (6_report.json)
        with timing, power, DRC, and area data from the completed flow.

        Please:
        1. Read the metrics JSON file from the input FileSet
        2. Produce a concise human-readable summary report with these sections:
           - Design: name, technology, area (um²), utilization (%)
           - Timing: clock period, WNS, TNS, whether timing is met
           - Power: total power estimate
           - Quality: DRC violation count, whether flow passed
           - Recommendations: any issues or suggestions
        3. Write the summary to a file called 'flow_summary.txt' in the run directory
        4. Return the result JSON with the summary file as an output FileSet of type 'text'
